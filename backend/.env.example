# PatchPilot Environment Variables
PORT=8000

# GitHub Integration
# Create a Personal Access Token with repo / issues scopes at https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional Webhook Secret for HMAC verification when configuring GitHub repository webhooks
GITHUB_WEBHOOK_SECRET=

# Optional OpenAI API Key for live GPT-4o-mini classification and text-embedding-3-small
# If omitted, PatchPilot uses its deterministic local semantic classifier and n-gram vectorizer
OPENAI_API_KEY=
